### List Beers
< ../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v3/beer
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive-mongo

### Get Beer by ID
< ../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v3/beer/6a2d83ecab4742f4bea391a6
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive-mongo

### Create Beer
< ../scripts/traceparent.js
POST http://localhost:{{gateway-port}}/api/v3/beer
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive-mongo

{
    "beerName": "presidente",
    "beerStyle": "LAGER",
    "upc": "xx",
    "quantityOnHand": 5,
    "price": 27.16
}

