meta {
  name: 1) list beers (sets {{beerId}})
  type: http
  seq: 1
}

get {
  url: http://localhost:{{gateway-port}}/api/v4/beer
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-data-rest
}

tests {
  const beers = (res.body._embedded && res.body._embedded.beers) || [];
  if (beers.length > 0) {
      const first = beers[0];
      const selfHref = first._links.self.href;
      const beerId = selfHref.substring(selfHref.lastIndexOf("/") + 1);
      bru.setVar("beerId", beerId);
      console.log("listBeers -> saved beerId=" + beerId + " (" + first.beerName + ")");
  } else {
      console.log("listBeers -> no beer found");
  }
  test("listBeers returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
}

docs {
  Flow: listBeers -> updateBeer -> deleteBeer — see restRequests/data-rest/beer-flow-list-update-delete/beer-flow-list-update-delete.md

