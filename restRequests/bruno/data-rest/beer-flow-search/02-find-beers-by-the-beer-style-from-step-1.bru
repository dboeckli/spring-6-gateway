meta {
  name: 2) find beers by the beer style from step 1 (uses {{beerStyle}})
  type: http
  seq: 2
}

get {
  url: http://localhost:{{gateway-port}}/api/v4/beer/search/findAllByBeerStyle?beerStyle={{beerStyle}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-data-rest
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const beerStyle = bru.getVar("beerStyle");
  console.log("findAllByBeerStyle -> beerStyle=" + beerStyle);
  if (!beerStyle) {
      throw new Error("beerStyle is not set - run 'find a beer by UPC' first");
  }
}

tests {
  const beers = (res.body._embedded && res.body._embedded.beers) || [];
  test("findAllByBeerStyle returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("findAllByBeerStyle returns at least one beer", function () {
      expect(beers.length > 0, "no beers returned").to.be.true;
  });
  test("all returned beers have the requested style", function () {
      beers.forEach(function (beer) {
          expect(beer.beerStyle === bru.getVar("beerStyle"), "beerStyle mismatch: " + beer.beerStyle).to.be.true;
      });
  });
}

