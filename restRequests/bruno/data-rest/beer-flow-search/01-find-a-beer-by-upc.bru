meta {
  name: 1) find a beer by UPC (sets {{beerId}} and {{beerStyle}})
  type: http
  seq: 1
}

get {
  url: http://localhost:{{gateway-port}}/api/v4/beer/search/findByUpc?upc=2380867498485
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-data-rest
}

tests {
  const selfHref = res.body && res.body._links && res.body._links.self && res.body._links.self.href;
  if (selfHref) {
      const beerId = selfHref.substring(selfHref.lastIndexOf("/") + 1);
      bru.setVar("beerId", beerId);
      bru.setVar("beerStyle", res.body.beerStyle);
      console.log("findByUpc -> saved beerId=" + beerId + ", beerStyle=" + res.body.beerStyle);
  } else {
      console.log("findByUpc -> no beer found");
  }
  test("findByUpc returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("findByUpc returns the requested upc", function () {
      expect(res.body.upc === "2380867498485", "upc mismatch").to.be.true;
  });
}

docs {
  Flow: findByUpc -> findAllByBeerStyle — see restRequests/data-rest/beer-flow-search/beer-flow-search.md

