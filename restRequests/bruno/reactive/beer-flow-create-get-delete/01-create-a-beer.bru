meta {
  name: 1) create a beer (sets {{beerId}} from the Location header)
  type: http
  seq: 1
}

post {
  url: http://localhost:{{gateway-port}}/api/v2/beer
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive
}

body:json {
  {
      "beerName": "Flow Beer",
      "beerStyle": "LAGER",
      "upc": "0631234200042",
      "quantityOnHand": 42,
      "price": 12.50
  }
}

tests {
  const location = res.getHeader("Location");
  if (location) {
      const beerId = location.substring(location.lastIndexOf("/") + 1);
      bru.setVar("beerId", beerId);
      console.log("createBeer -> saved beerId=" + beerId + " from " + location);
  } else {
      console.log("createBeer -> no Location header");
  }
  test("createBeer returns 201", function () {
      expect(res.status === 201, "expected 201 but got " + res.status).to.be.true;
  });
  test("createBeer returns a Location header", function () {
      expect(!!location, "Location header missing").to.be.true;
  });
}

docs {
  Flow: createBeer -> getBeer -> deleteBeer — see restRequests/reactive/beer-flow-create-get-delete/beer-flow-create-get-delete.md

