meta {
  name: 3) delete the created beer (uses {{beerId}})
  type: http
  seq: 3
}

delete {
  url: http://localhost:{{gateway-port}}/api/v2/beer/{{beerId}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const beerId = bru.getVar("beerId");
  console.log("deleteBeer -> beerId=" + beerId);
  if (!beerId) {
      throw new Error("beerId is not set - run 'create a beer' first");
  }
}

tests {
  test("deleteBeer returns 204", function () {
      expect(res.status === 204, "expected 204 but got " + res.status).to.be.true;
  });
}

