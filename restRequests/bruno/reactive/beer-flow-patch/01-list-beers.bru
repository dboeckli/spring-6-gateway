meta {
  name: 1) list beers (sets {{beerId}}, {{originalBeerName}}, {{originalBeerStyle}})
  type: http
  seq: 1
}

get {
  url: http://localhost:{{gateway-port}}/api/v2/beer
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive
}

tests {
  const beers = res.body || [];
  if (beers.length > 0) {
      const first = beers[0];
      bru.setVar("beerId", first.id);
      bru.setVar("originalBeerName", first.beerName);
      bru.setVar("originalBeerStyle", first.beerStyle);
      console.log("listBeers -> saved beerId=" + first.id + " (" + first.beerName + ", " + first.beerStyle + ")");
  } else {
      console.log("listBeers -> no beer found");
  }
  test("listBeers returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("listBeers returns at least one beer", function () {
      expect(beers.length > 0, "no beers returned").to.be.true;
  });
}

