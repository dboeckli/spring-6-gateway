meta {
  name: 1) list customers (sets {{customerId}}, {{originalCustomerName}})
  type: http
  seq: 1
}

get {
  url: http://localhost:{{gateway-port}}/api/v2/customer
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive
}

tests {
  const customers = res.body || [];
  if (customers.length > 0) {
      const first = customers[0];
      bru.setVar("customerId", first.id);
      bru.setVar("originalCustomerName", first.customerName);
      console.log("listCustomers -> saved customerId=" + first.id + " (" + first.customerName + ")");
  } else {
      console.log("listCustomers -> no customer found");
  }
  test("listCustomers returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("listCustomers returns at least one customer", function () {
      expect(customers.length > 0, "no customers returned").to.be.true;
  });
}

