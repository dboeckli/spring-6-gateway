meta {
  name: 2) patch the customer (PATCH)
  type: http
  seq: 2
}

patch {
  url: http://localhost:{{gateway-port}}/api/v2/customer/{{customerId}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive
}

body:json {
  {
      "customerName": "Patched Customer"
  }
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const customerId = bru.getVar("customerId");
  console.log("patchCustomer -> customerId=" + customerId);
  if (!customerId) {
      throw new Error("customerId is not set - run 'list customers' first");
  }
}

tests {
  test("patchCustomer returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
}

