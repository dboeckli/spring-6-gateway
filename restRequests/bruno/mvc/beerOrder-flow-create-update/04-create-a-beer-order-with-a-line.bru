meta {
  name: 3) create a beer order with a line (sets {{beerOrderId}} and {{beerOrderLineId}})
  type: http
  seq: 4
}

post {
  url: http://localhost:{{gateway-port}}/api/v1/beerOrder/createBeerOrder
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

body:json {
  {
    "customerId": "{{customerId}}",
    "customerRef": "bootstrap1",
    "beerOrderLines": [
      {
        "beerId": "{{beerId}}",
        "orderQuantity": 5
      }
    ]
  }
}

tests {
  bru.setVar("beerOrderId", res.body.id);
  console.log("Created beer order id: " + res.body.id);
  if (res.body.beerOrderLines && res.body.beerOrderLines.length > 0) {
      bru.setVar("beerOrderLineId", res.body.beerOrderLines[0].id);
      console.log("Created beer order line id: " + res.body.beerOrderLines[0].id);
  }

  test("createBeerOrder returns 201", function () {
      expect(res.status === 201, "expected 201 but got " + res.status).to.be.true;
  });
  test("createBeerOrder returns id and one line", function () {
      expect(!!res.body.id, "beerOrderId missing").to.be.true;
      expect(res.body.beerOrderLines && res.body.beerOrderLines.length === 1, "expected exactly 1 beer order line").to.be.true;
  });
}

