meta {
  name: 2) edit the created customer (PUT, uses {{customerId}} + {{customerVersion}})
  type: http
  seq: 2
}

put {
  url: http://localhost:{{gateway-port}}/api/v1/customer/editCustomer/{{customerId}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

body:json {
  {
    "name": "customer-flow-edited",
    "version": "{{customerVersion}}"
  }
}

tests {
  test("editCustomer returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("edited customer name matches", function () {
      expect(res.body.name === "customer-flow-edited", "name mismatch").to.be.true;
  });
}

