meta {
  name: 1) list beers (sets {{beerId}})
  type: http
  seq: 1
}

get {
  url: http://localhost:{{gateway-port}}/api/v1/beer/listBeers
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

tests {
  if (res.body.content.length > 0) {
      const first = res.body.content[0];
      bru.setVar("beerId", first.id);
      console.log("listBeers -> saved beerId=" + first.id + " (" + first.beerName + ")");
  } else {
      console.log("listBeers -> no beer found");
  }
  test("listBeers returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
}

