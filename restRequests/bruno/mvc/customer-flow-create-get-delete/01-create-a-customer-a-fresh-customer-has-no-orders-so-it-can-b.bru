meta {
  name: 1) create a customer (sets {{customerId}}) — a fresh customer has no orders, so it can be deleted
  type: http
  seq: 1
}

post {
  url: http://localhost:{{gateway-port}}/api/v1/customer/createCustomer
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

body:json {
  {
    "name": "customer-flow",
    "version": "0"
  }
}

tests {
  bru.setVar("customerId", res.body.id);
  console.log("Created customer id: " + res.body.id);

  test("createCustomer returns 201", function () {
      expect(res.status === 201, "expected 201 but got " + res.status).to.be.true;
  });
  test("createCustomer returns id and name", function () {
      expect(!!res.body.id, "customerId missing").to.be.true;
      expect(res.body.name === "customer-flow", "unexpected name").to.be.true;
  });
}

docs {
  Flow: createCustomer -> getCustomerById -> deleteCustomer — see restRequests/mvc/customer-flow-create-get-delete/customer-flow-create-get-delete.md

