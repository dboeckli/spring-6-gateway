meta {
  name: 2) get customer by id (logs and checks {{customerId}} before sending)
  type: http
  seq: 2
}

get {
  url: http://localhost:{{gateway-port}}/api/v1/customer/getCustomerById/{{customerId}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const customerId = bru.getVar("customerId");
  console.log("getCustomerById -> customerId=" + customerId);
  if (!customerId) {
      throw new Error("customerId is not set - run 'create customer' first");
  }
}

tests {
  test("getCustomerById returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("returned customer id matches", function () {
      expect(res.body.id === bru.getVar("customerId"), "customerId mismatch").to.be.true;
  });
}

