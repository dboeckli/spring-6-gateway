meta {
  name: 4) update the listed beer order (uses {{beerOrderId}} + {{beerOrderLineId}})
  type: http
  seq: 4
}

put {
  url: http://localhost:{{gateway-port}}/api/v1/beerOrder/updateBeerOrder/{{beerOrderId}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

body:json {
  {
      "customerId": "{{customerId}}",
      "customerRef": "bootstrap1",
      "beerOrderLines": [
          {
              "id": "{{beerOrderLineId}}",
              "beerId": "{{beerId}}",
              "orderQuantity": 5,
              "quantityAllocated": 0
          }
      ],
      "paymentAmount": 99.99
  }
}

tests {
  test("updateBeerOrder returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("updated beer order id matches", function () {
      expect(res.body.id === bru.getVar("beerOrderId"), "beerOrderId mismatch").to.be.true;
  });
}

