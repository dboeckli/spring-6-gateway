tests {
  if (res.body.length > 0) {
      const first = res.body[0];
      bru.setVar("customerId", first.id);
      console.log("listCustomer -> saved customerId=" + first.id + " (" + first.name + ")");
  } else {
      console.log("listCustomer -> no customer found");
  }
  test("listCustomer returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
}

