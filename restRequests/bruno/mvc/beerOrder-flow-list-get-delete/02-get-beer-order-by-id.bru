meta {
  name: 2) get beer order by id (logs and checks {{beerOrderId}} before sending)
  type: http
  seq: 2
}

get {
  url: http://localhost:{{gateway-port}}/api/v1/beerOrder/getBeerOrderyById/{{beerOrderId}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const beerOrderId = bru.getVar("beerOrderId");
  console.log("getBeerOrderyById -> beerOrderId=" + beerOrderId);
  if (!beerOrderId) {
      throw new Error("beerOrderId is not set - run 'list beer orders' first");
  }
}

tests {
  test("getBeerOrderyById returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("returned beer order id matches", function () {
      expect(res.body.id === bru.getVar("beerOrderId"), "beerOrderId mismatch").to.be.true;
  });
}

