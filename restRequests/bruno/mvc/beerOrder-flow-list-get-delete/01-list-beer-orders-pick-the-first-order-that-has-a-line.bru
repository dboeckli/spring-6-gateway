meta {
  name: 1) list beer orders — pick the first order that HAS a line (sets {{beerOrderId}} + {{beerOrderLineId}})
  type: http
  seq: 1
}

get {
  url: http://localhost:{{gateway-port}}/api/v1/beerOrder/listBeerOrders
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

tests {
  const orderWithLine = res.body.content.find(order => order.beerOrderLines && order.beerOrderLines.length > 0);
  if (orderWithLine) {
      bru.setVar("beerOrderId", orderWithLine.id);
      bru.setVar("beerOrderLineId", orderWithLine.beerOrderLines[0].id);
      console.log("listBeerOrders -> saved beerOrderId=" + orderWithLine.id + " (line=" + orderWithLine.beerOrderLines[0].id + ")");
  } else {
      console.log("listBeerOrders -> no beer order with a line found");
  }
}

