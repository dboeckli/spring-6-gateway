meta {
  name: 1) create a beer (sets {{beerId}} and {{beerVersion}})
  type: http
  seq: 1
}

post {
  url: http://localhost:{{gateway-port}}/api/v1/beer/createBeer
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

body:json {
  {
    "version": 0,
    "beerName": "presidente",
    "beerStyle": "LAGER",
    "upc": "xx",
    "quantityOnHand": 5,
    "price": 27.16
  }
}

tests {
  bru.setVar("beerId", res.body.id);
  bru.setVar("beerVersion", res.body.version);
  console.log("Created beer id: " + res.body.id + " (version=" + res.body.version + ")");

  test("createBeer returns 201", function () {
      expect(res.status === 201, "expected 201 but got " + res.status).to.be.true;
  });
  test("createBeer returns id and name", function () {
      expect(!!res.body.id, "beerId missing").to.be.true;
      expect(res.body.beerName === "presidente", "unexpected beerName").to.be.true;
  });
}

