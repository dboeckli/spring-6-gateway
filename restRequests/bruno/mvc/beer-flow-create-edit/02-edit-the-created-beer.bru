meta {
  name: 2) edit the created beer (uses {{beerId}} + {{beerVersion}})
  type: http
  seq: 2
}

put {
  url: http://localhost:{{gateway-port}}/api/v1/beer/editBeer/{{beerId}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

body:json {
  {
    "version": {{beerVersion}},
    "beerName": "presidente-edited",
    "beerStyle": "PALE_ALE",
    "upc": "xx-edited",
    "quantityOnHand": 7,
    "price": 28.50
  }
}

tests {
  test("editBeer returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("edited beer name matches", function () {
      expect(res.body.beerName === "presidente-edited", "beerName mismatch").to.be.true;
  });
}

