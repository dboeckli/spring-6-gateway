meta {
  name: 2) patch beer by id (uses {{beerId}})
  type: http
  seq: 2
}

patch {
  url: http://localhost:{{gateway-port}}/api/v1/beer/patchBeer/{{beerId}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-rest-mvc
}

body:json {
  {
    "beerName": "patched-beername"
  }
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const beerId = bru.getVar("beerId");
  console.log("patchBeer -> beerId=" + beerId);
  if (!beerId) {
      throw new Error("beerId is not set - run 'list beers' first");
  }
}

tests {
  test("patchBeer returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("patched beer name matches", function () {
      expect(res.body.beerName === "patched-beername", "beerName mismatch").to.be.true;
  });
}

