meta {
  name: 1) create a customer (sets {{customerId}} from the Location header)
  type: http
  seq: 1
}

post {
  url: http://localhost:{{gateway-port}}/api/v3/customer
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive-mongo
}

body:json {
  {
      "customerName": "Flow Customer"
  }
}

tests {
  const location = res.getHeader("Location");
  if (location) {
      const customerId = location.substring(location.lastIndexOf("/") + 1);
      bru.setVar("customerId", customerId);
      console.log("createCustomer -> saved customerId=" + customerId + " from " + location);
  } else {
      console.log("createCustomer -> no Location header");
  }
  test("createCustomer returns 201", function () {
      expect(res.status === 201, "expected 201 but got " + res.status).to.be.true;
  });
  test("createCustomer returns a Location header", function () {
      expect(!!location, "Location header missing").to.be.true;
  });
}

docs {
  Flow: createCustomer -> getCustomer -> deleteCustomer — see restRequests/reactive-mongo/customer-flow-create-get-delete/customer-flow-create-get-delete.md

