meta {
  name: 2) patch the beer (PATCH, only beerName is sent)
  type: http
  seq: 2
}

patch {
  url: http://localhost:{{gateway-port}}/api/v3/beer/{{beerId}}
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive-mongo
}

body:json {
  {
      "beerName": "Blessed Patched"
  }
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const beerId = bru.getVar("beerId");
  console.log("patchBeer -> beerId=" + beerId);
  if (!beerId) {
      throw new Error("beerId is not set - run 'list beers' first");
  }
}

tests {
  test("patchBeer returns 204", function () {
      expect(res.status === 204, "expected 204 but got " + res.status).to.be.true;
  });
}

docs {
  Source: reactive-mongo/beer-flow-patch/beer-flow-patch.http
  Generated by tools/http-to-bru.mjs
}
