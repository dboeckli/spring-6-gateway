meta {
  name: 2) get the created beer (uses {{beerId}})
  type: http
  seq: 2
}

get {
  url: http://localhost:{{gateway-port}}/api/v3/beer/{{beerId}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
  traceparent: 00-{{traceId}}-{{spanId}}-03
  baggage: testBaggage=spring-6-reactive-mongo
}

script:pre-request {
  function randomHex(length) {
      let result = '';
      const chars = '0123456789abcdef';
      for (let i = 0; i < length; i++) {
          result += chars[Math.floor(Math.random() * chars.length)];
      }
      return result;
  }
  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const beerId = bru.getVar("beerId");
  console.log("getBeerById -> beerId=" + beerId);
  if (!beerId) {
      throw new Error("beerId is not set - run 'create a beer' first");
  }
}

tests {
  test("getBeerById returns 200", function () {
      expect(res.status === 200, "expected 200 but got " + res.status).to.be.true;
  });
  test("beerName matches the created beer", function () {
      expect(res.body.beerName === "Flow Beer", "beerName mismatch").to.be.true;
  });
  test("beerStyle matches the created beer", function () {
      expect(res.body.beerStyle === "LAGER", "beerStyle mismatch").to.be.true;
  });
}

