script:pre-request {
  function randomHex(length) {
    let result = "";
    const chars = "0123456789abcdef";
    for (let i = 0; i < length; i++) {
      result += chars[Math.floor(Math.random() * chars.length)];
    }
    return result;
  }

  bru.setVar("traceId", randomHex(32));
  bru.setVar("spanId", randomHex(16));

  const clientId = bru.getProcessEnv("BRUNO_CLIENT_ID") || bru.getEnvVar("clientId") || "messaging-client";
  const clientSecret = bru.getProcessEnv("BRUNO_CLIENT_SECRET") || bru.getEnvVar("clientSecret") || "secret";
  bru.setEnvVar("clientId", clientId);
  bru.setEnvVar("clientSecret", clientSecret);
}
