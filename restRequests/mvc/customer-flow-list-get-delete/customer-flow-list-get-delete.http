# Flow: listCustomer -> getCustomerById -> deleteCustomer — see restRequest/customer-flow-list-get-delete/customer-flow-list-get-delete.md

### 1) list customers (sets {{customerId}})
< ../../scripts/traceparent.js
GET http://localhost:{{application-port}}/api/v1/customer/listCustomer
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    if (response.body.length > 0) {
        const first = response.body[0];
        client.global.set("customerId", first.id);
        client.log("listCustomer -> saved customerId=" + first.id + " (" + first.name + ")");
    } else {
        client.log("listCustomer -> no customer found");
    }
    client.test("listCustomer returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
%}

### 2) get customer by id (logs and checks {{customerId}} before sending)
< {%
    function randomHex(length) {
        let result = '';
        const chars = '0123456789abcdef';
        for (let i = 0; i < length; i++) {
            result += chars[Math.floor(Math.random() * chars.length)];
        }
        return result;
    }
    request.variables.set("traceId", randomHex(32));
    request.variables.set("spanId", randomHex(16));

    const customerId = client.global.get("customerId");
    client.log("getCustomerById -> customerId=" + customerId);
    if (!customerId) {
        throw new Error("customerId is not set - run 'list customers' first");
    }
%}
GET http://localhost:{{application-port}}/api/v1/customer/getCustomerById/{{customerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("getCustomerById returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("returned customer id matches", function () {
        client.assert(response.body.id === client.global.get("customerId"), "customerId mismatch");
    });
%}

### 3) delete the customer by id
< ../../scripts/traceparent.js
DELETE http://localhost:{{application-port}}/api/v1/customer/deleteCustomer/{{customerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("deleteCustomer returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
%}
