# Flow: listBeers -> createBeer -> getBeerById -> deleteBeer — see restRequest/beer-flow-list-get-delete/beer-flow-list-get-delete.md

### 1) list beers (smoke-checks the list endpoint)
< ../../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v1/beer/listBeers
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.log("listBeers -> " + response.body.content.length + " beer(s) on first page");
    client.test("listBeers returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
%}

### 2) create a dedicated beer for the delete flow (sets {{beerId}})
< ../../scripts/traceparent.js
POST http://localhost:{{gateway-port}}/api/v1/beer/createBeer
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

{
  "version": 0,
  "beerName": "delete-flow-beer",
  "beerStyle": "LAGER",
  "upc": "delete-flow",
  "quantityOnHand": 1,
  "price": 1.00
}

> {%
    client.global.set("beerId", response.body.id);
    client.log("Created beer id: " + response.body.id);

    client.test("createBeer returns 201", function () {
        client.assert(response.status === 201, "expected 201 but got " + response.status);
    });
    client.test("createBeer returns id", function () {
        client.assert(!!response.body.id, "beerId missing");
    });
%}

### 3) get the created beer by id (logs and checks {{beerId}} before sending)
< ../../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v1/beer/getBeerById/{{beerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("getBeerById returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("returned beer id matches", function () {
        client.assert(response.body.id === client.global.get("beerId"), "beerId mismatch");
    });
%}

### 4) delete the created beer by id
< ../../scripts/traceparent.js
DELETE http://localhost:{{gateway-port}}/api/v1/beer/deleteBeer/{{beerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("deleteBeer returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
%}
