# Flow: listBeers -> getBeerById -> deleteBeer — see restRequest/beer-flow-list-get-delete/beer-flow-list-get-delete.md

### 1) list beers (sets {{beerId}})
< ../../scripts/traceparent.js
GET http://localhost:{{application-port}}/api/v1/beer/listBeers
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    if (response.body.content.length > 0) {
        const first = response.body.content[0];
        client.global.set("beerId", first.id);
        client.log("listBeers -> saved beerId=" + first.id + " (" + first.beerName + ")");
    } else {
        client.log("listBeers -> no beer found");
    }
    client.test("listBeers returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
%}

### 2) get beer by id (logs and checks {{beerId}} before sending)
< {%
    function randomHex(length) {
        let result = '';
        const chars = '0123456789abcdef';
        for (let i = 0; i < length; i++) {
            result += chars[Math.floor(Math.random() * chars.length)];
        }
        return result;
    }
    request.variables.set("traceId", randomHex(32));
    request.variables.set("spanId", randomHex(16));

    const beerId = client.global.get("beerId");
    client.log("getBeerById -> beerId=" + beerId);
    if (!beerId) {
        throw new Error("beerId is not set - run 'list beers' first");
    }
%}
GET http://localhost:{{application-port}}/api/v1/beer/getBeerById/{{beerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("getBeerById returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("returned beer id matches", function () {
        client.assert(response.body.id === client.global.get("beerId"), "beerId mismatch");
    });
%}

### 3) delete the beer by id
< ../../scripts/traceparent.js
DELETE http://localhost:{{application-port}}/api/v1/beer/deleteBeer/{{beerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("deleteBeer returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
%}
