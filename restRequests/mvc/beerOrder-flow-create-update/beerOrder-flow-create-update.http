# Flow: createBeerOrder -> updateBeerOrder — see restRequests/mvc/beerOrder-flow-create-update/beerOrder-flow-create-update.md

### 1a) list customer (sets {{customerId}})
< ../../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v1/customer/listCustomer
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    if (response.body.length > 0) {
        const first = response.body[0];
        client.global.set("customerId", first.id);
        client.log("listCustomer -> saved customerId=" + first.id + " (" + first.name + ")");
    }
%}

### 1b) create a customer (alternative to 1a — provides a fresh {{customerId}})
< ../../scripts/traceparent.js
POST http://localhost:{{gateway-port}}/api/v1/customer/createCustomer
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

{
  "name": "beer-order-customer",
  "version": "0"
}

> {%
    client.global.set("customerId", response.body.id);
    client.log("Created customer id: " + response.body.id);
%}

### 2) list beers (sets {{beerId}})
< ../../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v1/beer/listBeers
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    if (response.body.content.length > 0) {
        const first = response.body.content[0];
        client.global.set("beerId", first.id);
        client.log("listBeers -> saved beerId=" + first.id);
    }
%}

### 3) create a beer order with a line (sets {{beerOrderId}} and {{beerOrderLineId}})
< ../../scripts/traceparent.js
POST http://localhost:{{gateway-port}}/api/v1/beerOrder/createBeerOrder
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

{
  "customerId": "{{customerId}}",
  "customerRef": "bootstrap1",
  "beerOrderLines": [
    {
      "beerId": "{{beerId}}",
      "orderQuantity": 5
    }
  ]
}

> {%
    client.global.set("beerOrderId", response.body.id);
    client.log("Created beer order id: " + response.body.id);
    if (response.body.beerOrderLines && response.body.beerOrderLines.length > 0) {
        client.global.set("beerOrderLineId", response.body.beerOrderLines[0].id);
        client.log("Created beer order line id: " + response.body.beerOrderLines[0].id);
    }

    client.test("createBeerOrder returns 201", function () {
        client.assert(response.status === 201, "expected 201 but got " + response.status);
    });
    client.test("createBeerOrder returns id and one line", function () {
        client.assert(!!response.body.id, "beerOrderId missing");
        client.assert(response.body.beerOrderLines && response.body.beerOrderLines.length === 1, "expected exactly 1 beer order line");
    });
%}

### 4) update the created beer order (uses {{beerOrderId}} + {{beerOrderLineId}})
< ../../scripts/traceparent.js
PUT http://localhost:{{gateway-port}}/api/v1/beerOrder/updateBeerOrder/{{beerOrderId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

{
    "customerId": "{{customerId}}",
    "customerRef": "bootstrap1",
    "beerOrderLines": [
        {
            "id": "{{beerOrderLineId}}",
            "beerId": "{{beerId}}",
            "orderQuantity": 5,
            "quantityAllocated": 0
        }
    ],
    "paymentAmount": 99.99
}

> {%
    client.test("updateBeerOrder returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("updated beer order id matches", function () {
        client.assert(response.body.id === client.global.get("beerOrderId"), "beerOrderId mismatch");
    });
%}
