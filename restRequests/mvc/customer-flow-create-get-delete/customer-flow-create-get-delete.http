# Flow: createCustomer -> getCustomerById -> deleteCustomer — see restRequests/mvc/customer-flow-create-get-delete/customer-flow-create-get-delete.md

### 1) create a customer (sets {{customerId}}) — a fresh customer has no orders, so it can be deleted
< ../../scripts/traceparent.js
POST http://localhost:{{gateway-port}}/api/v1/customer/createCustomer
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

{
  "name": "customer-flow",
  "version": "0"
}

> {%
    client.global.set("customerId", response.body.id);
    client.log("Created customer id: " + response.body.id);

    client.test("createCustomer returns 201", function () {
        client.assert(response.status === 201, "expected 201 but got " + response.status);
    });
    client.test("createCustomer returns id and name", function () {
        client.assert(!!response.body.id, "customerId missing");
        client.assert(response.body.name === "customer-flow", "unexpected name");
    });
%}

### 2) get customer by id (logs and checks {{customerId}} before sending)
< {%
    function randomHex(length) {
        let result = '';
        const chars = '0123456789abcdef';
        for (let i = 0; i < length; i++) {
            result += chars[Math.floor(Math.random() * chars.length)];
        }
        return result;
    }
    request.variables.set("traceId", randomHex(32));
    request.variables.set("spanId", randomHex(16));

    const customerId = client.global.get("customerId");
    client.log("getCustomerById -> customerId=" + customerId);
    if (!customerId) {
        throw new Error("customerId is not set - run 'create customer' first");
    }
%}
GET http://localhost:{{gateway-port}}/api/v1/customer/getCustomerById/{{customerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("getCustomerById returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("returned customer id matches", function () {
        client.assert(response.body.id === client.global.get("customerId"), "customerId mismatch");
    });
%}

### 3) delete the customer by id
< ../../scripts/traceparent.js
DELETE http://localhost:{{gateway-port}}/api/v1/customer/deleteCustomer/{{customerId}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-rest-mvc

> {%
    client.test("deleteCustomer returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
%}
