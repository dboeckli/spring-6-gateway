### List Customers
< ../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v2/customer
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive

### Get Customer by ID
< ../scripts/traceparent.js
GET http://localhost:{{gateway-port}}/api/v2/customer/1
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive

### Create Customer
< ../scripts/traceparent.js
POST http://localhost:{{gateway-port}}/api/v2/customer
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive

{
    "customerName": "Ich bin neu"
}

### Create Customer returns BAD REQUEST, customerName is to short
< ../scripts/traceparent.js
POST http://localhost:{{gateway-port}}/api/v2/customer
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive

{
    "customerName": "p"
}

### Update Customer by ID
< ../scripts/traceparent.js
PUT http://localhost:{{gateway-port}}/api/v2/customer/1
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive

{
    "customerName": "newCustomerName"
}

### Update Customer by ID returns BAD REQUEST, customerName is empty
< ../scripts/traceparent.js
PUT http://localhost:{{gateway-port}}/api/v2/customer/1
Accept: application/json
Authorization: Bearer {{$auth.token("auth-id")}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=spring-6-reactive

{
    "customerName": ""
}

